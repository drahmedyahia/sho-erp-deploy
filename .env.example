# Sho-ERP deploy — قالب الإعداد. انسخه إلى .env (install.sh يفعل ذلك ويولّد الأسرار).
# لا تضع قيمًا حقيقية في هذا الملف؛ .env غير مُتتبَّع في git.

############ أسرار (يولّدها install.sh — لا تكتبها يدويًا) ############
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
MINIO_ROOT_PASSWORD=
POSTGRES_PASSWORD=
DASHBOARD_PASSWORD=
DASHBOARD_USERNAME=admin

############ العناوين (يضبطها install.sh من سؤال واحد) ############
# العنوان العام الذي يفتحه المتصفح للوصول إلى بوابة API، مثال: https://erp.example.com
# أو http://192.168.1.10:8000 للتجربة الداخلية.
SUPABASE_PUBLIC_URL=http://localhost:8000
# يجب أن ينتهي بـ /auth/v1 (صيغة v0.7+).
API_EXTERNAL_URL=http://localhost:8000/auth/v1
# عنوان التطبيق نفسه (روابط البريد وإعادة التوجيه).
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

############ التطبيق ############
APP_IMAGE=ghcr.io/drahmedyahia/sho-erp-release:latest
APP_PORT=3000
# 127.0.0.1 إذا وضعت وكيلًا عكسيًا (Caddy/Nginx) أمامه.
APP_BIND=0.0.0.0
API_GW_HTTP_PORT=8000
API_GW_BIND=0.0.0.0
INSTALL_STATUS_TOKEN=
BOOTSTRAP_ADMIN_EMAIL=

############ قاعدة البيانات ############
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############ الدخول (GoTrue) ############
# التسجيل العام مغلق: المستخدمون يُنشَأون من داخل التطبيق فقط.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
JWT_EXPIRY=3600
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############ بريد GoTrue (غير مستعمل) ############
# التطبيق يرسل كل رسائله بنفسه (الإعدادات ← البريد الإلكتروني: SMTP + القوالب)،
# بما فيها رابط استرداد كلمة السر. لا تضبط شيئًا هنا؛ القيم وهمية ولا يُرسَل بها شيء.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Sho ERP

############ التخزين ############
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=stub

############ لوحة Studio (profile admin فقط) ############
STUDIO_DEFAULT_ORGANIZATION=Sho ERP
STUDIO_DEFAULT_PROJECT=Sho ERP

############ Supabase only (written by `sh install.sh --supabase-only`; leave unset otherwise) ############
# SHO_MODE=supabase-only
# Docker network of the project and, on it, the database's name (<name>-db). An app joins it.
# SUPABASE_NETWORK=sho-supabase
# Publish the database port too (an app that cannot join the network).
# DB_BIND=127.0.0.1
# DB_PORT=55432
# COMPOSE_FILE=docker-compose.yml:docker-compose.supabase-only.yml
